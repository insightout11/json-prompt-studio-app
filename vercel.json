{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/react-app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/react-app.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|app|assets|favicon|logo|android-icon|apple-icon|ms-icon|browserconfig|manifest|robots|sitemap|privacy|terms|success|cancel).+)",
      "destination": "/index.html"
    }
  ]
}