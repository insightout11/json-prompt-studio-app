{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/app",
      "dest": "/app.html"
    },
    {
      "src": "/app/(.*)",
      "dest": "/app.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*\\.(css|js|ico|svg|png|jpg|jpeg|gif|woff|woff2|ttf|eot|map|json))",
      "dest": "/$1"
    },
    {
      "src": "/(privacy-policy|terms-of-service|success|cancel)",
      "dest": "/$1.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}