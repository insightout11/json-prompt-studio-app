{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/react-app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/react-app.html"
    },
    {
      "source": "/(privacy-policy|terms-of-service|success|cancel)",
      "destination": "/$1.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}