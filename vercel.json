{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/(privacy-policy|terms-of-service|success|cancel)",
      "destination": "/$1.html"
    },
    {
      "source": "/((?!api|_next|assets|favicon|logo|android-icon|apple-icon|ms-icon|browserconfig|manifest|robots|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}