---
import Base from '../layouts/Base.astro';
import PromptViewer from '../components/PromptViewer.astro';
import { adTemplateItems, categories, allTemplates, viralItems } from '../lib/catalog.js';
import { MODEL_LIST } from '../lib/models.js';

const featured = categories
  .filter((c) => c.slug !== 'ads' && (c.templates.length > 0 || (c.addOns ?? []).length > 0))
  .slice(0, 12);
const demo = adTemplateItems[0] ?? allTemplates.find((t) => t.slug === 'young-woman-walking') ?? allTemplates[0];
const adFeatured = adTemplateItems.slice(0, 6);
---

<Base title="JSON Prompt Studio - model-aware JSON prompts for AI video ads">
  <section class="hero">
    <p class="kicker">structured prompts for AI video ads</p>
    <h1>Turn one idea into model-ready <em>ad prompts</em>.</h1>
    <p class="lede">
      Convert ad, product and UGC ideas into JSON shaped for Veo 3.1, Kling 3.0,
      Seedance 2.0, Wan and Runway. Start from proven structures with brand,
      references, audio, negatives and model-specific limits built in.
    </p>
    <div class="run-links" style="margin-top:1.6rem">
      <a href="/convert/" style="border-color:var(--amber); color:var(--amber)">Convert your ad idea</a>
      <a href="/ads/">Ad & UGC prompts</a>
      <a href="/builder/">Open builder</a>
      <a href="/prompts/">Browse templates</a>
    </div>
    <div class="hero-stats">
      <div><b>{allTemplates.length + viralItems.length}</b> templates</div>
      <div><b>{adTemplateItems.length}</b> ad flagships</div>
      <div><b>{MODEL_LIST.length}</b> models supported</div>
      <div><b>$0</b> no signup, no paywall</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Ad & UGC flagships</h2>
      <a href="/ads/">what are you making? -></a>
    </div>
    <div class="grid">
      {adFeatured.map((t) => (
        <a class="card" href={`/prompts/${t.categorySlug}/${t.slug}/`}>
          <span class="count">{t.format}</span>
          <h3>{t.name}</h3>
          <p>{t.description}</p>
          <span class="count">brand + references + negatives</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <p class="kicker">try one</p>
    <h2>One structure, every model</h2>
    <p class="dim small">
      The same ad structure is automatically re-ordered and adjusted for each
      model: Seedance wants camera first, Veo carries audio, Wan and Runway drop it.
    </p>
    <PromptViewer fields={demo.fields} name={demo.name} />
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Template library</h2>
      <a href="/prompts/">all {categories.length} categories -></a>
    </div>
    <div class="grid">
      {featured.map((c) => (
        <a class="card" href={`/prompts/${c.slug}/`}>
          <span class="icon">{c.icon}</span>
          <h3>{c.name}</h3>
          <p>{c.description}</p>
          <span class="count">{c.templates.length} templates</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Viral video formats</h2>
      <a href="/viral/">all formats -></a>
    </div>
    <div class="grid">
      {viralItems.slice(0, 8).map((v) => (
        <a class="card" href={`/viral/${v.slug}/`}>
          <h3>{v.name}</h3>
          <p>{v.description}</p>
          <span class="count">{v.categoryName}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Model guides</h2>
      <a href="/models/">all guides -></a>
    </div>
    <div class="grid">
      {MODEL_LIST.map((m) => (
        <a class="card" href={`/models/${m.id}/`}>
          <h3>{m.name}</h3>
          <p>{m.tagline}</p>
          <span class="count">{m.vendor}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
