---
import Base from '../../layouts/Base.astro';
import PromptViewer from '../../components/PromptViewer.astro';
import { adTemplateItems } from '../../lib/catalog.js';

const featured = adTemplateItems.slice().sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0));
const demo = featured[0];
const formats = [...new Set(featured.map((t) => t.format).filter(Boolean))];
---

<Base
  title={`AI Ad Prompt Templates - ${adTemplateItems.length} production JSON prompts for UGC and product video`}
  description="Model-aware JSON prompt templates for AI video ads: product heroes, UGC testimonials, unboxing, app demos, before/after, founder videos and more."
>
  <nav class="crumbs"><a href="/">home</a> / ads</nav>
  <p class="kicker">what are you making?</p>
  <h1>Ad & UGC prompt structures</h1>
  <p class="lede dim" style="margin-top:0.8rem; max-width:66ch">
    Production-grade JSON prompts for performance creative. Start with a proven ad
    structure, then switch tabs for the model you are actually using.
  </p>

  <div class="run-links" style="margin-top:1.4rem">
    <a href="/convert/" style="border-color:var(--amber); color:var(--amber)">Convert your idea</a>
    <a href="/builder/">Open builder</a>
    <a href="/prompts/">Browse all templates</a>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>Use cases</h2>
      <span class="dim small">{formats.length} ad formats</span>
    </div>
    <div class="use-case-grid">
      {formats.map((format) => (
        <a class="card" href={`#${format.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`}>
          <h3>{format}</h3>
          <p>{featured.filter((t) => t.format === format).length} production structures</p>
        </a>
      ))}
    </div>
  </section>

  {demo && (
    <section class="section">
      <p class="kicker">flagship example</p>
      <h2>{demo.name}</h2>
      <p class="dim small" style="max-width:64ch">{demo.description}</p>
      <PromptViewer fields={demo.fields} name={demo.name} />
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>All ad flagships</h2>
      <span class="dim small">brand + references + negatives included</span>
    </div>
    <div class="grid">
      {featured.map((t) => (
        <a class="card" href={`/prompts/${t.categorySlug}/${t.slug}/`} id={t.format?.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}>
          <span class="count">{t.format}</span>
          <h3>{t.name}</h3>
          <p>{t.description}</p>
          <span class="count">{Object.keys(t.fields).length} fields</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>Brand and reference caveat</h2>
    <p class="dim small" style="max-width:68ch">
      Hex colors are creative direction, not exact color management. Video models
      approximate palette and cannot reliably render exact logos or readable UI.
      Use reference images for product shape and style, then add exact logos, UI,
      captions, claims and compliance text in post.
    </p>
  </section>
</Base>
